# Base URL the server uses to call the rmeme backend
RMEME_API_URL=https://api.rmeme.me
# Base URL shown to visitors on the site (defaults to RMEME_API_URL)
RMEME_PUBLIC_API_URL=https://api.rmeme.me
# API key used on the server for voting and meme permalinks. Never sent to the browser.
RMEME_API_KEY=
